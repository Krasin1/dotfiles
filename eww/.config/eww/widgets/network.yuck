;; you ugly mother fucker
(defpoll interface 
    :interval "4s"
    `ip -j route get 8.8.8.8 2>/dev/null | jq -ec '.[0] | [.dev, .prefsrc]' || echo '[\"none\",\"\"]'`
)

(defwidget network []
    (box 
        :orientation "v"
        :halign "center"
        :tooltip "${interface[0]}
${interface[1]}"
        :style "min-width: 5em"
        (box 
            :space-evenly false
            (label
                :style "font-size: 0.82em; color: #d5c8ff;"
                :text "↓"
            )
            (label 
                :halign "start"
                :style "font-size: 0.82em;"
                :text " ${formatbytes(ceil(EWW_NET[interface[0]].NET_DOWN), false, "si")}"
            )
        )

        (box 
            :space-evenly false
            (label
                :style "font-size: 0.82em; color: #17a2b8" 
                :text "↑"
            )
            (label 
                :halign "start"
                :style "font-size: 0.82em;"
                :text " ${formatbytes(ceil(EWW_NET[interface[0]].NET_UP), false, "si")}"
            )
        )
    )
)
