;; Карта { "DP-1": "ddcci4", "DP-2": "ddcutil:5" }.
;; Бар не получает backend при запуске: если ddcci прицепится позже
;; (или монитор доступен только через ddcutil), виджет подхватит его сам.
(defpoll backlight_map
    :interval "5s"
    :initial "{}"
    "~/dotfiles/scripts/backlight-map.sh"
)

(defpoll brightness
    :interval "5s"
    :initial "{}"
    "~/dotfiles/scripts/brightness.sh get"
)

(defwidget brightness [mon_name]
    (eventbox 
        :visible {(backlight_map?.[mon_name] ?: "") != ""}
        :halign "center"
        :cursor "row-resize"
        :onscroll "~/dotfiles/scripts/brightness.sh {} ${backlight_map?.[mon_name]} ${mon_name}"
        :onclick "~/dotfiles/scripts/brightness.sh max ${backlight_map?.[mon_name]} ${mon_name}"
        :onrightclick "~/dotfiles/scripts/brightness.sh min ${backlight_map?.[mon_name]} ${mon_name}"

        :tooltip "Brightness ${mon_name}
LMB: set 100%
RMB: set 0%"

        (box :orientation "h" 
            :space-evenly false
            :style "min-width:4.1em"
            (label 
                :hexpand true
                :class "icons"
                :style "color: #FFB86C"
                :text ""
            )
            (label 
                :text "${brightness?.[(backlight_map?.[mon_name] ?: "")] ?: 0}%"
            )
        )
    )
)
