#!/bin/bash

# set -euo pipefail

# Завершаем старые eww бары (eww работает от текущего пользователя,
# sudo тут не нужен и может залипнуть на запросе пароля)
eww kill >/dev/null 2>&1 || true

# Получаем список мониторов
monitors_json=$(hyprctl monitors -j)

# Hyprland уже включил выходы, но ddcci@.service мог сдаться, пока монитор
# спал. Повторяем udev-add для i2c-адаптеров — правило заново запустит юнит.
# Для уже подключённых ddcci юнит выходит мгновенно.
sudo -n udevadm trigger --subsystem-match=i2c --action=add >/dev/null 2>&1 || true

# Не блокируем запуск бара: виджет яркости сам подхватит backlight,
# как только он появится (scripts/backlight-map.sh).

# Проходим по каждому монитору
while read -r monitor; do
    mon_id=$(echo "$monitor" | jq -r '.id')
    mon_name=$(echo "$monitor" | jq -r '.name')

    # Получаем ширину монитора
    width=$(echo "$monitors_json" | jq -r ".[] | select(.id == $mon_id) | .width")

    # Запускаем eww бар для монитора
    eww open bar \
        --id "$mon_id" \
        --screen "$mon_name" \
        --arg MON_W="$width" \
        --arg MON_NAME="$mon_name"

    eww open right_click \
        --id "10$mon_id" \
        --screen "$mon_name" \
        --arg MON_NAME="$mon_name"

done <<< "$(echo "$monitors_json" | jq -c '.[] | {id: .id, name: .name}')"

# Автоматический запуск на ново подключенных мониторах
~/.config/eww/scripts/monitor.sh &
