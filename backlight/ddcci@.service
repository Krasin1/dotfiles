[Unit]
Description=ddcci attach for %i
# Юнит запускается udev-правилом при появлении i2c-адаптера GPU, без
# привязки к graphical.target: к старту Hyprland подсветка уже готова.
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
# Монитор может ещё спать в момент загрузки (DDC/CI отвечает -ENODEV),
# поэтому пробуем прицепиться ~30 секунд.
TimeoutStartSec=90
ExecStart=/bin/bash -c '\
    modprobe ddcci_backlight || { echo "ddcci_backlight is not available" >&2; exit 0; }; \
    bus=$${1#i2c-}; \
    adapter=/sys/bus/i2c/devices/i2c-$$bus; \
    backlight=/sys/class/backlight/ddcci$$bus; \
    [ -d "$$adapter" ] || exit 0; \
    awake=0; \
    for _ in {1..30}; do \
        [ -d "$$backlight" ] && exit 0; \
        echo 0x37 >"$$adapter/delete_device" 2>/dev/null || true; \
        echo ddcci 0x37 >"$$adapter/new_device" 2>/dev/null || true; \
        [ -d "$$backlight" ] && exit 0; \
        echo 0x37 >"$$adapter/delete_device" 2>/dev/null || true; \
        if command -v ddcutil >/dev/null 2>&1 && \
            ddcutil getvcp 10 --bus "$$bus" --sleep-multiplier 0.2 --disable-dynamic-sleep >/dev/null 2>&1; then \
            awake=$$((awake + 1)); \
            if [ "$$awake" -ge 5 ]; then \
                echo "ddcci cannot attach to i2c-$$bus, DDC/CI works via ddcutil" >&2; \
                exit 0; \
            fi; \
        else \
            awake=0; \
        fi; \
        sleep 1; \
    done; \
    echo "no DDC/CI display on $${1}" >&2' _ %i
