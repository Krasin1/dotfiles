# ~/.ssh/config
# Управляется через stow (пакет: ssh) — stow ssh
# Ключи для git подключаются точечно, чтобы github/gitlab
# не перебирали чужие ключи: IdentitiesOnly запрещает пробовать другие.
# AddKeysToAgent: после первого успешного использования ключ сам
# попадает в ssh-agent (нужен запущенный ssh-agent.service).

Host github.com
    IdentityFile ~/.ssh/git_ssh
    IdentitiesOnly yes
    AddKeysToAgent yes

Host gitlab.com
    IdentityFile ~/.ssh/git_lab_ssh
    IdentitiesOnly yes
    AddKeysToAgent yes

# Остальные хосты: положить использованный ключ в агент.
Host *
    AddKeysToAgent yes